# Modelo base para fine-tuning (Hugging Face hub ID)
BASE_MODEL=unsloth/Phi-3-mini-4k-instruct

# Hugging Face (necessário para modelos com gate, ex: LLaMA)
HF_TOKEN=hf_seu_token_aqui

# Groq (opcional — para usar LLM via API sem fine-tuning local)
GROQ_API_KEY=sua_chave_groq_aqui

# OpenAI (opcional — embeddings ou fallback)
OPENAI_API_KEY=sua_chave_openai_aqui

# Caminhos
MODEL_PATH=./models/fine_tuned
CHROMA_PATH=./chroma_db
DB_PATH=./data/hospital.db
LOG_PATH=./logs/assistant.jsonl
